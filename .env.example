# Copy this file to .env.local for local development and fill in your own values.
# NEVER commit real values. Set the same names in the hosting provider's environment settings for production.

# --- MongoDB (required) ---
MONGODB_URI=your-mongodb-connection-string

# --- Admin authentication (required: there are NO built-in fallbacks) ---
# Admin login and all /api/admin/* routes stay disabled until all three are set.
# JWT_SECRET: long random string (32+ characters) used to sign admin tokens.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=choose-an-admin-username
ADMIN_PASSWORD=choose-a-strong-unique-password

# --- Razorpay (required for online payments) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Public key used by the browser checkout (same key id as above; never put the secret here)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# --- UPI (optional) ---
# Used by /api/payment/create-qr. The payment page itself reads the UPI VPA from admin site settings.
UPI_VPA=your-upi-vpa
NEXT_PUBLIC_UPI_VPA=your-upi-vpa

# --- Google Sheets sync for biodata via SheetDB (optional) ---
# If unset, biodata is still saved to MongoDB and the sheet sync is skipped.
SHEETDB_URL=your-sheetdb-endpoint-url
